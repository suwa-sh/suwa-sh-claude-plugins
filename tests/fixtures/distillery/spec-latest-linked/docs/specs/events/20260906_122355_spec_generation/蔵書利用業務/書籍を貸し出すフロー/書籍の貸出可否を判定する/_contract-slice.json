{
  "asyncapi": null,
  "openapi": {
    "components": {
      "responses": {
        "BadRequest": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "バリデーションエラー（入力値が不正）"
        },
        "Forbidden": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "認可エラー（ロール不足、または本人限定参照に違反）"
        },
        "NotFound": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "リソース未存在"
        },
        "Unauthorized": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnauthorizedResponse"
              }
            }
          },
          "description": "認証エラー。次の 3 条件のときだけ返す。\n`UNAUTHENTICATED`（`Authorization` ヘッダ欠落 / Bearer 以外 / 署名不正）、\n`TOKEN_EXPIRED`（`exp` 超過）、`IDENTITY_CLAIM_MISSING`（`sub` / `role` /\n`role = 利用者` のときの `user_no` が欠落）。\n認証は成立しておりロール・所有者が不足する場合は 403（`FORBIDDEN`）とする。\n",
          "headers": {
            "WWW-Authenticate": {
              "description": "RFC 6750 の challenge。常に `Bearer realm=\"libra\"` で始め、\n`error=\"invalid_token\"` と `error_description` にエラーコードを載せる。\n",
              "required": true,
              "schema": {
                "examples": [
                  "Bearer realm=\"libra\", error=\"invalid_token\", error_description=\"TOKEN_EXPIRED\""
                ],
                "type": "string"
              }
            }
          }
        }
      },
      "schemas": {
        "BookId": {
          "description": "書籍を一意に識別する ID",
          "examples": [
            "BK-00000123"
          ],
          "maxLength": 36,
          "minLength": 1,
          "type": "string"
        },
        "BookStatus": {
          "description": "書籍状態のwire値。意味・遷移は docs/rdra/latest/状態.tsv の書籍状態を参照。",
          "enum": [
            "在庫あり",
            "貸出中",
            "予約待ち"
          ],
          "type": "string",
          "x-enum-varnames": [
            "AVAILABLE",
            "ON_LOAN",
            "RESERVED"
          ]
        },
        "BookSummary": {
          "description": "書籍の要約情報（一覧・関連表示用）",
          "properties": {
            "author": {
              "description": "著者",
              "maxLength": 100,
              "type": "string"
            },
            "book_id": {
              "$ref": "#/components/schemas/BookId"
            },
            "book_status": {
              "$ref": "#/components/schemas/BookStatus"
            },
            "genre": {
              "$ref": "#/components/schemas/Genre"
            },
            "isbn": {
              "description": "ISBN（13 桁または 10 桁。未設定の場合は null）",
              "type": [
                "string",
                "null"
              ]
            },
            "material_type": {
              "$ref": "#/components/schemas/MaterialType"
            },
            "publisher": {
              "description": "出版社",
              "maxLength": 100,
              "type": "string"
            },
            "registered_at": {
              "description": "登録日時",
              "format": "date-time",
              "type": "string"
            },
            "title": {
              "description": "タイトル",
              "maxLength": 200,
              "type": "string"
            },
            "updated_at": {
              "description": "更新日時",
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "book_id",
            "title",
            "author",
            "publisher",
            "genre",
            "material_type",
            "book_status"
          ],
          "type": "object"
        },
        "EligibilityReason": {
          "description": "貸出可否判定の根拠となる条件 1 件",
          "properties": {
            "condition_name": {
              "description": "条件名（貸出可否条件 / 取置き中書籍貸出条件 等）",
              "type": "string"
            },
            "detail": {
              "description": "判定の詳細説明",
              "type": "string"
            },
            "satisfied": {
              "description": "その条件を満たすか",
              "type": "boolean"
            }
          },
          "required": [
            "condition_name",
            "satisfied"
          ],
          "type": "object"
        },
        "ErrorResponse": {
          "description": "エラー応答の共通形式",
          "properties": {
            "code": {
              "description": "エラーコード",
              "examples": [
                "VALIDATION_ERROR"
              ],
              "type": "string"
            },
            "details": {
              "description": "項目単位のエラー内訳",
              "items": {
                "properties": {
                  "field": {
                    "description": "エラー対象の項目名",
                    "type": "string"
                  },
                  "message": {
                    "description": "項目単位のエラーメッセージ",
                    "type": "string"
                  }
                },
                "required": [
                  "field",
                  "message"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "message": {
              "description": "利用者向けのエラーメッセージ",
              "type": "string"
            },
            "trace_id": {
              "description": "リクエスト追跡 ID（問い合わせ時の識別子）",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        },
        "Genre": {
          "description": "ジャンル（バリエーション: ジャンル）",
          "enum": [
            "文学",
            "人文",
            "社会科学",
            "自然科学",
            "技術",
            "芸術",
            "児童",
            "その他"
          ],
          "type": "string",
          "x-enum-varnames": [
            "LITERATURE",
            "HUMANITIES",
            "SOCIAL_SCIENCE",
            "NATURAL_SCIENCE",
            "TECHNOLOGY",
            "ART",
            "CHILDREN",
            "OTHER"
          ]
        },
        "HoldSummary": {
          "description": "対象書籍に取置き中の予約がある場合のその予約情報",
          "properties": {
            "hold_expires_at": {
              "description": "取置き期限",
              "format": "date-time",
              "type": "string"
            },
            "holder_user_no": {
              "$ref": "#/components/schemas/UserNo"
            },
            "priority": {
              "description": "予約順位",
              "minimum": 1,
              "type": "integer"
            },
            "reservation_id": {
              "$ref": "#/components/schemas/ReservationId"
            }
          },
          "required": [
            "reservation_id",
            "priority",
            "holder_user_no"
          ],
          "type": "object"
        },
        "LoanEligibilityRequest": {
          "description": "貸出可否判定リクエスト",
          "properties": {
            "book_id": {
              "$ref": "#/components/schemas/BookId"
            },
            "user_no": {
              "$ref": "#/components/schemas/UserNo"
            }
          },
          "required": [
            "book_id",
            "user_no"
          ],
          "type": "object"
        },
        "LoanEligibilityResponse": {
          "description": "貸出可否の判定結果（永続化しない）",
          "properties": {
            "book": {
              "$ref": "#/components/schemas/BookSummary"
            },
            "eligible": {
              "description": "貸出を許可できるか",
              "type": "boolean"
            },
            "hold": {
              "$ref": "#/components/schemas/HoldSummary"
            },
            "reasons": {
              "description": "評価した条件と充足状況",
              "items": {
                "$ref": "#/components/schemas/EligibilityReason"
              },
              "type": "array"
            },
            "user": {
              "$ref": "#/components/schemas/LoanTargetResponse"
            }
          },
          "required": [
            "eligible",
            "reasons",
            "book",
            "user"
          ],
          "type": "object"
        },
        "LoanTargetResponse": {
          "description": "貸出対象利用者（利用者カード情報）",
          "properties": {
            "loanable": {
              "description": "貸出可否条件の利用者側判定結果。docs/rdra/latest/条件.tsv を参照。",
              "type": "boolean"
            },
            "name": {
              "description": "氏名",
              "type": "string"
            },
            "reason": {
              "description": "`loanable` が false のときの理由",
              "type": "string"
            },
            "user_category": {
              "$ref": "#/components/schemas/UserCategory"
            },
            "user_no": {
              "$ref": "#/components/schemas/UserNo"
            },
            "user_status": {
              "$ref": "#/components/schemas/UserStatus"
            }
          },
          "required": [
            "user_no",
            "name",
            "user_category",
            "user_status",
            "loanable"
          ],
          "type": "object"
        },
        "MaterialType": {
          "description": "資料種別のwire値。正本は docs/rdra/latest/バリエーション.tsv の資料種別。利用可能範囲は docs/rdra/latest/条件.tsv の資料種別利用可否条件を参照。",
          "enum": [
            "紙書籍",
            "電子書籍"
          ],
          "type": "string",
          "x-enum-varnames": [
            "PAPER_BOOK",
            "EBOOK"
          ]
        },
        "ReservationId": {
          "description": "予約を一意に識別する ID",
          "examples": [
            "RS-00000789"
          ],
          "maxLength": 36,
          "minLength": 1,
          "type": "string"
        },
        "UnauthorizedCode": {
          "description": "401 のエラーコード。\n`UNAUTHENTICATED` = ヘッダ欠落 / Bearer 以外 / 署名不正、\n`TOKEN_EXPIRED` = `exp` 超過、\n`IDENTITY_CLAIM_MISSING` = 必須クレーム欠落。\n",
          "enum": [
            "UNAUTHENTICATED",
            "TOKEN_EXPIRED",
            "IDENTITY_CLAIM_MISSING"
          ],
          "type": "string",
          "x-enum-varnames": [
            "UNAUTHENTICATED",
            "TOKEN_EXPIRED",
            "IDENTITY_CLAIM_MISSING"
          ]
        },
        "UnauthorizedResponse": {
          "description": "認証エラーの応答。`ErrorResponse` の `code` を 3 値に限定したもの。\n利用者識別情報の受け渡しは Bearer トークンのクレームだけであり、\n識別用の独自ヘッダが送られても認証結果は変わらない。\n",
          "properties": {
            "code": {
              "$ref": "#/components/schemas/UnauthorizedCode"
            },
            "message": {
              "description": "利用者向けのエラーメッセージ（識別子・トークンの中身を含めない）",
              "examples": [
                "再度ログインしてください"
              ],
              "type": "string"
            },
            "trace_id": {
              "description": "リクエスト追跡 ID",
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "type": "object"
        },
        "UserCategory": {
          "description": "利用者区分のwire値。正本は docs/rdra/latest/バリエーション.tsv の利用者区分。貸出期間との対応は",
          "enum": [
            "一般",
            "学生",
            "団体"
          ],
          "type": "string",
          "x-enum-varnames": [
            "GENERAL",
            "STUDENT",
            "GROUP"
          ]
        },
        "UserNo": {
          "description": "利用者を一意に識別する利用者番号",
          "examples": [
            "U-000123"
          ],
          "maxLength": 20,
          "minLength": 1,
          "type": "string"
        },
        "UserStatus": {
          "description": "利用者状態のwire値。意味・遷移は docs/rdra/latest/状態.tsv の利用者状態を参照。",
          "enum": [
            "登録済み",
            "取引進行中"
          ],
          "type": "string",
          "x-enum-varnames": [
            "REGISTERED",
            "IN_TRANSACTION"
          ]
        }
      },
      "securitySchemes": {
        "bearerAuth": {
          "bearerFormat": "JWT",
          "description": "外部マネージド IdP（OAuth2/OIDC）が発行したアクセストークン。\nAPI Gateway でトークンを検証し、`sub`（user_id）・役割（司書 / 利用者）・利用者番号を\nクレームとしてバックエンド API へ伝播する。\n\n本 API における利用者識別情報の送信方法はこのスキームだけであり、識別用の独自ヘッダ\n（`X-User-No` 等）は定義しない。必須クレームと 401 の条件は `info.description`\n「利用者識別情報の送信方法」に従う。\n\n必須クレーム:\n\n| クレーム | 型 | 必須 | 説明 |\n|---|---|---|---|\n| `sub` | string | 常に必須 | IdP のアカウント ID。監査ログの操作者 ID に使う |\n| `role` | string | 常に必須 | `司書` または `利用者`。RBAC の粗粒度判定に使う |\n| `user_no` | string | `role = 利用者` のとき必須 | 本人限定参照の絞り込み条件の唯一の入力 |\n| `exp` | integer | 常に必須 | 失効時刻。超過時は `TOKEN_EXPIRED` |\n",
          "scheme": "bearer",
          "type": "http"
        }
      }
    },
    "info": {
      "contact": {
        "name": "Libra 開発チーム",
        "url": "https://libra.example.com/support"
      },
      "description": "DRAFT: 貸出登録と参照依存3操作の契約。現行pipeline出力から型・制約を移行。RDRA/latestの業務条件不足はpipeline還流リクエストで解決し、対応する分岐の実装は保留する。冪等性の保存方式・障害回復・保持期間も未決定であり、このbundleだけで実装可とは判定しない。",
      "license": {
        "name": "Proprietary",
        "url": "https://libra.example.com/license"
      },
      "summary": "図書館蔵書管理システム Libra の HTTP API",
      "title": "貸出登録と照会API",
      "version": "1.0.0"
    },
    "openapi": "3.1.0",
    "paths": {
      "/api/v1/loans/eligibility-checks": {
        "post": {
          "description": "書籍と利用者の組合せに対する貸出可否と根拠条件を返す。業務条件の正本は docs/rdra/latest/条件.tsv の貸出可否条件・取置き中書籍貸出条件・資料種別利用可否条件。 descriptionから補完しない。判定による永続化は行わない。",
          "operationId": "checkLoanEligibility",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanEligibilityRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/LoanEligibilityResponse"
                  }
                }
              },
              "description": "貸出可否の判定結果"
            },
            "400": {
              "$ref": "#/components/responses/BadRequest"
            },
            "401": {
              "$ref": "#/components/responses/Unauthorized"
            },
            "403": {
              "$ref": "#/components/responses/Forbidden"
            },
            "404": {
              "$ref": "#/components/responses/NotFound"
            }
          },
          "summary": "書籍の貸出可否を判定する",
          "tags": [
            "loans"
          ]
        }
      }
    },
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "servers": [
      {
        "description": "本番環境（仕様ドキュメント用プレースホルダ）",
        "url": "https://api.libra.example.com"
      },
      {
        "description": "ステージング環境（仕様ドキュメント用プレースホルダ）",
        "url": "https://api.stg.libra.example.com"
      }
    ],
    "tags": [
      {
        "description": "蔵書（書籍）の登録・編集・削除・照会・検索",
        "name": "books"
      },
      {
        "description": "利用者の登録・編集・削除・照会（司書ロール限定）",
        "name": "users"
      },
      {
        "description": "ログイン中の利用者本人に限定した照会（本人限定参照）",
        "name": "me"
      },
      {
        "description": "貸出の可否判定・登録・返却・照会",
        "name": "loans"
      },
      {
        "description": "予約の登録・取消・順位照会",
        "name": "reservations"
      },
      {
        "description": "取置き（予約順 1 位への取り置き）の候補特定と状況照会",
        "name": "holds"
      },
      {
        "description": "延滞判定と延滞中貸出の照会",
        "name": "overdues"
      },
      {
        "description": "返却期限接近の貸出の判定・照会",
        "name": "duedates"
      },
      {
        "description": "取置き案内 / 返却期限リマインド / 延滞督促の通知実績と再送",
        "name": "notifications"
      },
      {
        "description": "在庫状況・貸出統計の集計要求とレポート参照",
        "name": "reports"
      }
    ]
  },
  "schema_version": "distillery.contract-slice/v1"
}
