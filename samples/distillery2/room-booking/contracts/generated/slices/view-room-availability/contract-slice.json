                      "endAt": "2026-11-11T01:00:00+09:00",
                      "startAt": "2026-11-10T23:00:00+09:00"
                    }
                  },
                  "invalid_time_range_reversed": {
                    "summary": "開始 11:00 が終了 10:00 より後",
                    "value": {
                      "endAt": "2026-11-10T10:00:00+09:00",
                      "startAt": "2026-11-10T11:00:00+09:00"
                    }
                  },
                  "not_on_30_minutes": {
                    "summary": "開始 10:10 が 30 分刻みでない",
                    "value": {
                      "endAt": "2026-11-10T11:00:00+09:00",
                      "startAt": "2026-11-10T10:10:00+09:00"
                    }
                  },
                  "reserved_without_owner": {
                    "summary": "社員Bが 2026-11-10 10:00-11:00 を照会する (会議室Aに社員Aの予約がある)",
                    "value": {
                      "endAt": "2026-11-10T11:00:00+09:00",
                      "startAt": "2026-11-10T10:00:00+09:00"
                    },
                    "x-headers": {
                      "Authorization": "Bearer test-employee-b"
                    }
                  },
                  "success": {
                    "summary": "2026-11-10 10:00-11:00 (予約が無く全会議室が空き)",
                    "value": {
                      "endAt": "2026-11-10T11:00:00+09:00",
                      "startAt": "2026-11-10T10:00:00+09:00"
                    }
                  },
                  "unauthorized": {
                    "summary": "Authorization ヘッダが無い",
                    "value": {
                      "endAt": "2026-11-10T11:00:00+09:00",
                      "startAt": "2026-11-10T10:00:00+09:00"
                    },
                    "x-headers": {
                      "Authorization": null
                    }
                  },
                  "validation_error": {
                    "summary": "終了の日時が無い",
                    "value": {
                      "startAt": "2026-11-10T10:00:00+09:00"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/TimeRange"
                }
              }
            },
            "required": true
          },
