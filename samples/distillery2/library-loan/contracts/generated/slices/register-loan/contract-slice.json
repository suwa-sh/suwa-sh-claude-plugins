{
  "asyncapi": null,
  "openapi": {
    "components": {
      "parameters": {
        "IdempotencyKey": {
          "description": "更新系 API の再送判定キー。同じキーの再送では副作用を重複させず、初回と同じ応答を返す",
          "example": "7c1e8a52-3f0d-4c1b-9d2e-6a4b5c3d2e1f",
          "in": "header",
          "name": "Idempotency-Key",
          "required": true,
          "schema": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        }
      },
      "schemas": {
        "BookId": {
          "description": "書籍ID",
          "format": "uuid",
          "type": "string"
        },
        "BookStatus": {
          "description": "書籍状態。available=在庫あり、on_loan=貸出中、awaiting_pickup=予約待ち",
          "enum": [
            "available",
            "on_loan",
            "awaiting_pickup"
          ],
          "type": "string"
        },
        "FieldError": {
          "properties": {
            "field": {
              "description": "エラーのある入力項目名",
              "type": "string"
            },
            "message": {
              "description": "項目ごとのエラー文言",
              "type": "string"
            }
          },
          "required": [
            "field",
            "message"
          ],
          "type": "object"
        },
        "Loan": {
          "description": "貸出",
          "properties": {
            "bookId": {
              "$ref": "#/components/schemas/BookId"
            },
            "dueDate": {
              "description": "返却期限。貸出日に貸出期間を加えた日 (返却期限算出条件)",
              "format": "date",
              "type": "string"
            },
            "loanId": {
              "$ref": "#/components/schemas/LoanId"
            },
            "loanedOn": {
              "description": "貸出日",
              "format": "date",
              "type": "string"
            },
            "patronNumber": {
              "$ref": "#/components/schemas/PatronNumber"
            },
            "reservationId": {
              "description": "予約順 1 位の利用者への貸出のとき、完了にした予約の予約ID。それ以外は null",
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            },
            "returnedOn": {
              "description": "返却日。未返却なら null",
              "format": "date",
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/components/schemas/LoanStatus"
            }
          },
          "required": [
            "loanId",
            "patronNumber",
            "bookId",
            "reservationId",
            "loanedOn",
            "dueDate",
            "returnedOn",
            "status"
          ],
          "type": "object"
        },
        "LoanId": {
          "description": "貸出ID",
          "format": "uuid",
          "type": "string"
        },
        "LoanRegistration": {
          "description": "貸出の登録結果。登録した貸出と、貸出後の書籍状態を返す",
          "properties": {
            "bookStatus": {
              "$ref": "#/components/schemas/BookStatus"
            },
            "loan": {
              "$ref": "#/components/schemas/Loan"
            }
          },
          "required": [
            "loan",
            "bookStatus"
          ],
          "type": "object"
        },
        "LoanStatus": {
          "description": "貸出状態。on_loan=貸出中、returned=返却済、overdue=延滞",
          "enum": [
            "on_loan",
            "returned",
            "overdue"
          ],
          "type": "string"
        },
        "PatronNumber": {
          "description": "利用者番号 (一意)",
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "Problem": {
          "description": "RFC 9457 Problem Details。code はクライアントが分岐に使う安定した識別子",
          "properties": {
            "code": {
              "$ref": "#/components/schemas/ProblemCode"
            },
            "detail": {
              "description": "この発生に固有の説明",
              "type": "string"
            },
            "errors": {
              "description": "入力検証エラーの項目別内訳 (code が validation_error のとき)",
              "items": {
                "$ref": "#/components/schemas/FieldError"
              },
              "type": "array"
            },
            "instance": {
              "description": "この発生を識別する URI 参照",
              "type": "string"
            },
            "status": {
              "description": "HTTP ステータスコード",
              "maximum": 599,
              "minimum": 400,
              "type": "integer"
            },
            "title": {
              "description": "問題種別の要約 (利用者に表示できる文言)",
              "type": "string"
            },
            "type": {
              "description": "問題種別の URI",
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "type",
            "title",
            "status",
            "code"
          ],
          "type": "object"
        },
        "ProblemCode": {
          "description": "エラーの安定識別子。業務ルール違反の細分は UC で enum に足す",
          "enum": [
            "validation_error",
            "unauthorized",
            "forbidden",
            "not_found",
            "business_rule_violation",
            "idempotency_key_conflict",
            "internal_error",
            "book_on_loan",
            "not_first_in_reservation_queue",
            "patron_not_registered",
            "no_active_loan"
          ],
          "type": "string"
        },
        "RegisterLoanRequest": {
          "additionalProperties": false,
          "description": "貸出の登録要求。貸出日はサーバーの当日の日付で決まるため要求に含めない",
          "properties": {
            "bookId": {
              "$ref": "#/components/schemas/BookId"
            },
            "patronNumber": {
              "$ref": "#/components/schemas/PatronNumber"
            }
          },
          "required": [
            "patronNumber",
            "bookId"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "bearerAuth": {
          "bearerFormat": "JWT",
          "description": "OIDC IdP が発行するアクセストークン。ロール (librarian / patron) と利用者番号をクレームに持つ",
          "scheme": "bearer",
          "type": "http"
        }
      }
    },
    "info": {
      "description": "図書館蔵書管理システムの backend-api が提供する API。\nconsumers は frontend (利用者・司書の画面) と worker (日次期限チェック・通知送信ジョブの起動)。\n認証は OIDC 準拠の IdP が発行するアクセストークン (Bearer) で行う (ADR 0006)。\nエラーは RFC 9457 の application/problem+json で返す。\n更新系 API (貸出・返却・予約・登録) は Idempotency-Key ヘッダを受け取る (ADR 0005)。\n",
      "title": "図書館蔵書管理システム API",
      "version": "0.1.0"
    },
    "openapi": "3.1.0",
    "paths": {
      "/loans": {
        "post": {
          "description": "司書が利用者番号と書籍IDを指定して貸出を登録する。librarian ロールだけが呼べる。\n貸出日はサーバーの当日の日付とし、返却期限は貸出日に貸出期間を加えた日を自動で設定する (返却期限算出条件)。\n貸出期間の日数は要求に値が無く、この契約では固定しない。example の dueDate は形を示すための値である。\n貸出可否条件:\n- 書籍状態が在庫あり (available) なら、登録済みの利用者に貸し出せる。\n- 書籍状態が予約待ち (awaiting_pickup) なら、予約順 1 位 (通知済) の利用者にだけ貸し出せる。このとき その予約を完了 (completed) にする。\n- 書籍状態が貸出中 (on_loan) の書籍は貸し出せない。\n- 登録されていない (論理削除済みを含む) 利用者には貸し出せない。\n貸し出せないときは 409 を返し、貸出を記録せず、書籍状態と予約状態を変えない。\n成功すると書籍状態を貸出中 (on_loan) にする。\n",
          "operationId": "registerLoan",
          "parameters": [
            {
              "$ref": "#/components/parameters/IdempotencyKey"
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "examples": {
                  "badRequest": {
                    "summary": "書籍IDが無い",
                    "value": {
                      "patronNumber": "P-00000001"
                    }
                  },
                  "bookOnLoan": {
                    "summary": "貸出中の書籍を貸し出そうとする",
                    "value": {
                      "bookId": "9e4a1c7b-3d5f-4a2e-8b6c-1f3e5a7c9b0d",
                      "patronNumber": "P-00000001"
                    }
                  },
                  "notFirstInReservationQueue": {
                    "summary": "予約待ちの書籍を予約順 1 位以外の利用者に貸し出そうとする",
                    "value": {
                      "bookId": "2c7f9b3e-6a1d-4c8e-9f2b-7d4a1e6c3b5f",
                      "patronNumber": "P-00000001"
                    }
                  },
                  "patronNotRegistered": {
                    "summary": "登録されていない利用者に貸し出そうとする",
                    "value": {
                      "bookId": "0b6f3c1e-2a4d-4e8f-9b1a-3c5d7e9f1a2b",
                      "patronNumber": "P-99999999"
                    }
                  },
                  "success": {
                    "summary": "在庫ありの書籍を登録済みの利用者に貸し出す",
                    "value": {
                      "bookId": "0b6f3c1e-2a4d-4e8f-9b1a-3c5d7e9f1a2b",
                      "patronNumber": "P-00000001"
                    }
                  },
                  "successFromReservation": {
                    "summary": "予約待ちの書籍を予約順 1 位 (通知済) の利用者に貸し出す",
                    "value": {
                      "bookId": "5d2e8a41-7c3b-4f60-8e1d-9a2b4c6d8e0f",
                      "patronNumber": "P-00000001"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RegisterLoanRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "201": {
              "content": {
                "application/json": {
                  "examples": {
                    "success": {
                      "summary": "在庫ありの書籍の貸出",
                      "value": {
                        "bookStatus": "on_loan",
                        "loan": {
                          "bookId": "0b6f3c1e-2a4d-4e8f-9b1a-3c5d7e9f1a2b",
                          "dueDate": "2026-10-15",
                          "loanId": "3f8a2d6c-1b4e-4a7f-9c2d-5e8b1a4d7c0e",
                          "loanedOn": "2026-10-01",
                          "patronNumber": "P-00000001",
                          "reservationId": null,
                          "returnedOn": null,
                          "status": "on_loan"
                        }
                      }
                    },
                    "successFromReservation": {
                      "summary": "予約順 1 位の利用者への貸出。予約は完了になる",
                      "value": {
                        "bookStatus": "on_loan",
                        "loan": {
                          "bookId": "5d2e8a41-7c3b-4f60-8e1d-9a2b4c6d8e0f",
                          "dueDate": "2026-10-15",
                          "loanId": "6a1c4e8b-2d5f-4b9a-8e3c-7f1a3d5b9c2e",
                          "loanedOn": "2026-10-01",
                          "patronNumber": "P-00000001",
                          "reservationId": "8b3d5f7a-4c2e-4d1b-9a6f-2e8c4a6b1d3f",
                          "returnedOn": null,
                          "status": "on_loan"
                        }
                      }
                    }
                  },
                  "schema": {
                    "$ref": "#/components/schemas/LoanRegistration"
                  }
                }
              },
              "description": "貸出を記録し、返却期限を設定し、書籍を貸出中にした"
            },
            "400": {
              "content": {
                "application/problem+json": {
                  "examples": {
                    "badRequest": {
                      "value": {
                        "code": "validation_error",
                        "errors": [
                          {
                            "field": "bookId",
                            "message": "書籍IDは必須です"
                          }
                        ],
                        "status": 400,
                        "title": "入力内容に誤りがあります",
                        "type": "https://library.example/problems/validation-error"
                      }
                    }
                  },
                  "schema": {
                    "$ref": "#/components/schemas/Problem"
                  }
                }
              },
              "description": "入力が不正 (必須項目の欠落・形式違反)"
            },
            "409": {
              "content": {
                "application/problem+json": {
                  "examples": {
                    "bookOnLoan": {
                      "value": {
                        "code": "book_on_loan",
                        "detail": "書籍 9e4a1c7b-3d5f-4a2e-8b6c-1f3e5a7c9b0d は貸出中です",
                        "status": 409,
                        "title": "この書籍は貸出中のため貸し出せません",
                        "type": "https://library.example/problems/book-on-loan"
                      }
                    },
                    "notFirstInReservationQueue": {
                      "value": {
                        "code": "not_first_in_reservation_queue",
                        "detail": "書籍 2c7f9b3e-6a1d-4c8e-9f2b-7d4a1e6c3b5f は予約待ちで、利用者 P-00000001 は予約順 1 位ではありません",
                        "status": 409,
                        "title": "この書籍は予約順 1 位の利用者にだけ貸し出せます",
                        "type": "https://library.example/problems/not-first-in-reservation-queue"
                      }
                    },
                    "patronNotRegistered": {
                      "value": {
                        "code": "patron_not_registered",
                        "detail": "利用者番号 P-99999999 の利用者は登録されていません",
                        "status": 409,
                        "title": "登録されていない利用者には貸し出せません",
                        "type": "https://library.example/problems/patron-not-registered"
                      }
                    }
                  },
                  "schema": {
                    "$ref": "#/components/schemas/Problem"
                  }
                }
              },
              "description": "貸出可否条件を満たさないため貸し出せない。貸出は記録されず、書籍状態と予約状態は変わらない"
            }
          },
          "summary": "貸出を登録する",
          "tags": [
            "loan"
          ],
          "x-test-headers": {
            "Authorization": "Bearer test-librarian-token",
            "Idempotency-Key": "{uuid}"
          }
        }
      }
    },
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "servers": [
      {
        "description": "ローカル開発",
        "url": "http://localhost:3000"
      }
    ],
    "tags": [
      {
        "description": "蔵書 (書籍の登録・編集・削除・検索)",
        "name": "catalog"
      },
      {
        "description": "利用者 (登録・編集・削除)",
        "name": "patron"
      },
      {
        "description": "貸出・返却・貸出履歴",
        "name": "loan"
      },
      {
        "description": "予約・予約取消・予約状況",
        "name": "reservation"
      },
      {
        "description": "通知 (返却通知・リマインド・督促) とジョブ起動",
        "name": "notification"
      },
      {
        "description": "蔵書分析 (在庫状況・人気書籍ランキング・貸出統計)",
        "name": "analytics"
      }
    ]
  },
  "schema_version": "distillery2.contract-slice/v1",
  "uc": "register-loan"
}
