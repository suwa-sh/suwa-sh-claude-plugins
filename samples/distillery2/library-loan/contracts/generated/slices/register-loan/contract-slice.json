{
  "asyncapi": null,
  "openapi": {
    "components": {
      "schemas": {
        "CopyStatus": {
          "description": "書籍の状態 (在庫あり・貸出中・取り置き中・除籍済み)",
          "enum": [
            "available",
            "on_loan",
            "on_hold",
            "withdrawn"
          ],
          "type": "string"
        },
        "CreateLoanRequest": {
          "additionalProperties": false,
          "description": "貸出登録の入力 (利用者番号 + 蔵書 ID)。返却期限はサーバーが算出するため受け取らない。",
          "properties": {
            "copy_id": {
              "$ref": "#/components/schemas/Id"
            },
            "patron_number": {
              "$ref": "#/components/schemas/PatronNumber"
            }
          },
          "required": [
            "patron_number",
            "copy_id"
          ],
          "type": "object"
        },
        "FieldError": {
          "properties": {
            "code": {
              "description": "検証エラーの識別子 (例: required, format, duplicate)",
              "type": "string"
            },
            "field": {
              "description": "項目名",
              "type": "string"
            },
            "message": {
              "description": "利用者に見せるメッセージ",
              "type": "string"
            }
          },
          "required": [
            "field",
            "code",
            "message"
          ],
          "type": "object"
        },
        "Id": {
          "description": "システムが採番する内部 ID",
          "format": "uuid",
          "type": "string"
        },
        "Loan": {
          "description": "貸出 (どの利用者にどの蔵書をいつ貸し出したか)。貸出登録の応答で、蔵書の状態と受取済みにした予約も返す。",
          "properties": {
            "book_title": {
              "description": "貸し出した蔵書の書籍タイトル",
              "type": "string"
            },
            "copy_id": {
              "$ref": "#/components/schemas/Id"
            },
            "copy_status": {
              "$ref": "#/components/schemas/CopyStatus"
            },
            "due_on": {
              "description": "返却期限 (貸出日 + 貸出日時点で有効な貸出ルールの貸出期間)",
              "format": "date",
              "type": "string"
            },
            "fulfilled_reservation_id": {
              "description": "本人向けの取り置きを貸し出して受取済みにした予約の ID (該当しなければ null)",
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "loan_id": {
              "$ref": "#/components/schemas/Id"
            },
            "loaned_on": {
              "description": "貸出日",
              "format": "date",
              "type": "string"
            },
            "patron_number": {
              "$ref": "#/components/schemas/PatronNumber"
            },
            "returned_on": {
              "description": "返却日 (未返却は null)",
              "format": "date",
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/components/schemas/LoanStatus"
            }
          },
          "required": [
            "loan_id",
            "patron_number",
            "copy_id",
            "book_title",
            "loaned_on",
            "due_on",
            "returned_on",
            "status",
            "copy_status",
            "fulfilled_reservation_id"
          ],
          "type": "object"
        },
        "LoanStatus": {
          "description": "貸出の状態 (貸出中・延滞中・返却済み)",
          "enum": [
            "on_loan",
            "overdue",
            "returned"
          ],
          "type": "string"
        },
        "PatronNumber": {
          "description": "システムが一意に採番する利用者番号",
          "type": "string"
        },
        "Problem": {
          "description": "エラー応答 (RFC 9457 Problem Details)。全 UC が 4xx/5xx で返す。",
          "properties": {
            "code": {
              "description": "業務エラーの識別子 (例: loan_not_allowed)",
              "type": "string"
            },
            "detail": {
              "description": "発生事例の詳細",
              "type": "string"
            },
            "errors": {
              "description": "入力項目ごとの検証エラー",
              "items": {
                "$ref": "#/components/schemas/FieldError"
              },
              "type": "array"
            },
            "instance": {
              "description": "発生事例の識別子",
              "type": "string"
            },
            "status": {
              "description": "HTTP ステータス",
              "type": "integer"
            },
            "title": {
              "description": "利用者に見せる短い説明",
              "type": "string"
            },
            "type": {
              "description": "問題種別の URI",
              "format": "uri",
              "type": "string"
            }
          },
          "required": [
            "type",
            "title",
            "status"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "bearerAuth": {
          "bearerFormat": "JWT",
          "description": "OIDC の認証基盤が発行したアクセストークン。backend-api が検証し、主体 ID を利用者または司書に対応づける (ADR 0006)。",
          "scheme": "bearer",
          "type": "http"
        }
      }
    },
    "info": {
      "description": "backend-api が提供し、frontend と worker が利用する HTTP API (ADR 0001 / 0005 / 0006)。",
      "title": "図書館蔵書管理システム API",
      "version": "0.1.0",
      "x-basis": "requirements@4422a431dd381e737d643e7055432ad4b2330c9d adr@090e13b71116c495162f84a620b4d303817fac08"
    },
    "openapi": "3.1.0",
    "paths": {
      "/loans": {
        "post": {
          "description": "司書が利用者番号と蔵書 ID を指定して貸出を登録する。在庫ありの蔵書、またはその利用者向けに取り置き中の蔵書だけ貸し出せる (条件「貸出可否」)。返却期限は貸出日に、貸出日時点で有効な貸出ルールの貸出期間を加えて設定する (条件「返却期限算出」)。本人向けの取り置き中の蔵書を貸し出すと、その予約は受取済みになる。司書だけが操作できる (条件「操作権限」。認証なしは 401、利用者区分が利用者なら 403 を Problem で返す)。",
          "operationId": "createLoan",
          "requestBody": {
            "content": {
              "application/json": {
                "examples": {
                  "copyNotFound": {
                    "summary": "存在しない蔵書 ID",
                    "value": {
                      "copy_id": "99999999-9999-4999-8999-999999999999",
                      "patron_number": "P-2026-00001"
                    }
                  },
                  "heldForOther": {
                    "summary": "他の利用者向けに取り置き中の蔵書を貸し出そうとする",
                    "value": {
                      "copy_id": "33333333-3333-4333-8333-333333333333",
                      "patron_number": "P-2026-00002"
                    }
                  },
                  "heldForSelf": {
                    "summary": "本人向けに取り置き中の蔵書を貸し出す",
                    "value": {
                      "copy_id": "33333333-3333-4333-8333-333333333333",
                      "patron_number": "P-2026-00001"
                    }
                  },
                  "onLoan": {
                    "summary": "他の利用者に貸出中の蔵書を貸し出そうとする",
                    "value": {
                      "copy_id": "22222222-2222-4222-8222-222222222222",
                      "patron_number": "P-2026-00002"
                    }
                  },
                  "patronNotFound": {
                    "summary": "登録されていない利用者番号",
                    "value": {
                      "copy_id": "11111111-1111-4111-8111-111111111111",
                      "patron_number": "P-2026-99999"
                    }
                  },
                  "success": {
                    "summary": "在庫ありの蔵書を貸し出す",
                    "value": {
                      "copy_id": "11111111-1111-4111-8111-111111111111",
                      "patron_number": "P-2026-00001"
                    }
                  },
                  "validation": {
                    "summary": "利用者番号が空",
                    "value": {
                      "copy_id": "11111111-1111-4111-8111-111111111111",
                      "patron_number": ""
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/CreateLoanRequest"
                }
              }
            },
            "required": true
          },
          "responses": {
            "201": {
              "content": {
                "application/json": {
                  "examples": {
                    "heldForSelf": {
                      "value": {
                        "book_title": "こころ",
                        "copy_id": "33333333-3333-4333-8333-333333333333",
                        "copy_status": "on_loan",
                        "due_on": "2026-10-04",
                        "fulfilled_reservation_id": "cccccccc-cccc-4ccc-8ccc-cccccccccccc",
                        "loan_id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
                        "loaned_on": "2026-09-20",
                        "patron_number": "P-2026-00001",
                        "returned_on": null,
                        "status": "on_loan"
                      }
                    },
                    "success": {
                      "value": {
                        "book_title": "吾輩は猫である",
                        "copy_id": "11111111-1111-4111-8111-111111111111",
                        "copy_status": "on_loan",
                        "due_on": "2026-09-15",
                        "fulfilled_reservation_id": null,
                        "loan_id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
                        "loaned_on": "2026-09-01",
                        "patron_number": "P-2026-00001",
                        "returned_on": null,
                        "status": "on_loan"
                      }
                    }
                  },
                  "schema": {
                    "$ref": "#/components/schemas/Loan"
                  }
                }
              },
              "description": "貸出を登録した"
            },
            "400": {
              "content": {
                "application/problem+json": {
                  "examples": {
                    "validation": {
                      "value": {
                        "errors": [
                          {
                            "code": "required",
                            "field": "patron_number",
                            "message": "利用者番号は必須です"
                          }
                        ],
                        "status": 400,
                        "title": "入力内容に誤りがあります",
                        "type": "https://library.example/problems/validation-error"
                      }
                    }
                  },
                  "schema": {
                    "$ref": "#/components/schemas/Problem"
                  }
                }
              },
              "description": "入力が不正 (必須項目の欠落・形式エラー)"
            },
            "404": {
              "content": {
                "application/problem+json": {
                  "examples": {
                    "copyNotFound": {
                      "value": {
                        "code": "copy_not_found",
                        "status": 404,
                        "title": "蔵書が見つかりません",
                        "type": "https://library.example/problems/not-found"
                      }
                    },
                    "patronNotFound": {
                      "value": {
                        "code": "patron_not_found",
                        "status": 404,
                        "title": "利用者が見つかりません",
                        "type": "https://library.example/problems/not-found"
                      }
                    }
                  },
                  "schema": {
                    "$ref": "#/components/schemas/Problem"
                  }
                }
              },
              "description": "利用者または蔵書が存在しない"
            },
            "409": {
              "content": {
                "application/problem+json": {
                  "examples": {
                    "heldForOther": {
                      "value": {
                        "code": "loan_not_allowed",
                        "detail": "この蔵書は他の利用者向けに取り置き中です。",
                        "status": 409,
                        "title": "貸し出せません",
                        "type": "https://library.example/problems/business-rule-violation"
                      }
                    },
                    "onLoan": {
                      "value": {
                        "code": "loan_not_allowed",
                        "detail": "この蔵書は貸出中です。",
                        "status": 409,
                        "title": "貸し出せません",
                        "type": "https://library.example/problems/business-rule-violation"
                      }
                    }
                  },
                  "schema": {
                    "$ref": "#/components/schemas/Problem"
                  }
                }
              },
              "description": "貸出可否により貸し出せない (貸出中・他の利用者向けに取り置き中・除籍済み)"
            }
          },
          "summary": "貸出を登録する",
          "tags": [
            "circulation"
          ]
        }
      }
    },
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "servers": [
      {
        "description": "backend-api (ベースパス /api)",
        "url": "/api"
      }
    ],
    "tags": [
      {
        "description": "蔵書 (書籍・蔵書)",
        "name": "catalog"
      },
      {
        "description": "利用者 (利用者・司書・ログイン)",
        "name": "patron"
      },
      {
        "description": "貸出予約 (貸出・返却・予約)",
        "name": "circulation"
      },
      {
        "description": "通知 (worker が起動するジョブ API)",
        "name": "notification"
      },
      {
        "description": "蔵書分析 (在庫状況・人気ランキング・貸出統計)",
        "name": "analytics"
      }
    ]
  },
  "schema_version": "distillery2.contract-slice/v1",
  "uc": "register-loan"
}
