{
  "asyncapi": null,
  "openapi": {
    "components": {
      "schemas": {
        "Error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_INPUT",
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "NOT_FOUND",
                "VERSION_CONFLICT",
                "IDEMPOTENCY_CONFLICT",
                "BUSINESS_RULE_VIOLATION",
                "CONFIGURATION_UNAVAILABLE",
                "DEPENDENCY_UNAVAILABLE"
              ],
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "trace_id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "trace_id"
          ],
          "type": "object"
        },
        "LoanStatistic": {
          "additionalProperties": false,
          "properties": {
            "aggregated_at": {
              "format": "date-time",
              "type": "string"
            },
            "book_author": {
              "minLength": 1,
              "type": "string"
            },
            "book_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "book_title": {
              "minLength": 1,
              "type": "string"
            },
            "genre_name": {
              "minLength": 1,
              "type": "string"
            },
            "loan_count": {
              "minimum": 0,
              "type": "integer"
            },
            "loan_total": {
              "minimum": 0,
              "type": "integer"
            },
            "period_end": {
              "format": "date",
              "type": "string"
            },
            "period_start": {
              "format": "date",
              "type": "string"
            },
            "period_type": {
              "enum": [
                "日",
                "月",
                "年"
              ],
              "type": "string"
            },
            "ranking": {
              "minimum": 0,
              "type": "integer"
            },
            "stat_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "stat_id",
            "period_type",
            "period_start",
            "period_end",
            "book_id",
            "loan_count",
            "loan_total",
            "ranking",
            "aggregated_at",
            "book_title",
            "book_author",
            "genre_name"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "BearerAuth": {
          "bearerFormat": "JWT",
          "scheme": "bearer",
          "type": "http"
        }
      }
    },
    "info": {
      "title": "図書館管理API",
      "version": "1.0.0"
    },
    "openapi": "3.1.0",
    "paths": {
      "/staff/analytics/popular-books": {
        "get": {
          "operationId": "getPopularBooks",
          "parameters": [
            {
              "in": "query",
              "name": "page",
              "schema": {
                "default": 1,
                "minimum": 1,
                "type": "integer"
              }
            },
            {
              "in": "query",
              "name": "page_size",
              "schema": {
                "default": 20,
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            },
            {
              "in": "query",
              "name": "period_type",
              "required": true,
              "schema": {
                "enum": [
                  "日",
                  "月",
                  "年"
                ],
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "period_start",
              "required": true,
              "schema": {
                "format": "date",
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "period_end",
              "required": true,
              "schema": {
                "format": "date",
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "additionalProperties": false,
                    "properties": {
                      "items": {
                        "items": {
                          "$ref": "#/components/schemas/LoanStatistic"
                        },
                        "type": "array"
                      },
                      "page": {
                        "type": "integer"
                      },
                      "page_size": {
                        "type": "integer"
                      },
                      "total": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "items",
                      "page",
                      "page_size",
                      "total"
                    ],
                    "type": "object"
                  }
                }
              },
              "description": "処理結果"
            },
            "400": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "入力形式不正"
            },
            "401": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "認証が必要"
            },
            "403": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "権限または接続経路違反"
            },
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "対象なし"
            },
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "競合または冪等キー不一致"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "業務条件不成立"
            },
            "503": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "設定または依存先を利用不可"
            }
          },
          "summary": "人気書籍ランキングを参照する",
          "tags": [
            "運営分析業務"
          ],
          "x-allowed-roles": [
            "司書"
          ],
          "x-authorization-rule": "ロールと経路を検証する。",
          "x-network": "館内"
        }
      }
    },
    "security": [
      {
        "BearerAuth": []
      }
    ],
    "servers": [
      {
        "url": "https://library.example.invalid/api"
      }
    ]
  },
  "schema_version": "distillery.contract-slice/v1"
}
