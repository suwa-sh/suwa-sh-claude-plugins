        "get": {
          "operationId": "getUserActivity",
          "parameters": [
            {
              "in": "path",
              "name": "user_number",
              "required": true,
              "schema": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/UserActivity"
                  }
                }
              },
              "description": "処理結果"
            },
            "400": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "入力形式不正"
            },
            "401": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "認証が必要"
            },
            "403": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "権限または接続経路違反"
            },
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "対象なし"
            },
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "競合または冪等キー不一致"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "業務条件不成立"
            },
            "503": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "設定または依存先を利用不可"
            }
          },
          "summary": "利用者の利用状況を参照する",
          "tags": [
            "利用者サービス業務"
          ],
          "x-allowed-roles": [
            "司書"
          ],
          "x-authorization-rule": "ロールと経路を検証する。",
          "x-network": "館内"
        }
      }
    },
    "security": [
      {
        "BearerAuth": []
      }
    ],
    "servers": [
      {
        "url": "https://library.example.invalid/api"
      }
    ]
