              "type": "string"
            },
            "book_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "book_title": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "current_status": {
              "enum": [
                "貸出中",
                "延滞",
                "返却済み"
              ],
              "type": "string"
            },
            "due_date": {
              "format": "date",
              "type": "string"
            },
            "loan_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "loaned_on": {
              "format": "date",
              "type": "string"
            },
