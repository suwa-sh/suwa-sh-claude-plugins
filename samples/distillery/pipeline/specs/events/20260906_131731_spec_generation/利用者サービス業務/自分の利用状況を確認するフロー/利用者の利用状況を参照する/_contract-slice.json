              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "returned_on": {
              "format": "date",
              "type": [
                "string",
                "null"
              ]
            },
            "updated_at": {
              "format": "date-time",
              "type": "string"
            },
            "user_name": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "user_number": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "loan_id",
            "book_id",
            "user_number",
            "loaned_on",
            "due_date",
            "current_status",
            "recorded_by",
            "version",
            "updated_at",
            "returned_on",
            "book_title",
            "book_author",
            "user_name"
          ],
          "type": "object"
        },
        "Reservation": {
          "additionalProperties": false,
          "properties": {
            "accepted_at": {
              "format": "date-time",
              "type": "string"
            },
            "book_author": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "book_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "book_title": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "current_status": {
              "enum": [
                "予約中",
                "通知済み",
                "取消",
                "終了"
              ],
              "type": "string"
            },
            "queue_position": {
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "reservation_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "updated_at": {
              "format": "date-time",
              "type": "string"
            },
            "user_name": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "user_number": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "reservation_id",
            "book_id",
            "user_number",
            "accepted_at",
            "queue_position",
            "current_status",
            "version",
            "updated_at",
            "book_title",
            "book_author",
            "user_name"
          ],
          "type": "object"
