{
  "asyncapi": null,
  "openapi": {
    "components": {
      "schemas": {
        "Error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_INPUT",
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "NOT_FOUND",
                "VERSION_CONFLICT",
                "IDEMPOTENCY_CONFLICT",
                "BUSINESS_RULE_VIOLATION",
                "CONFIGURATION_UNAVAILABLE",
                "DEPENDENCY_UNAVAILABLE"
              ],
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "trace_id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "trace_id"
          ],
          "type": "object"
        },
        "PeriodStatistics": {
          "additionalProperties": false,
          "properties": {
            "period_end": {
              "format": "date",
              "type": "string"
            },
            "period_start": {
              "format": "date",
              "type": "string"
            },
            "period_type": {
              "enum": [
                "日",
                "月",
                "年"
              ],
              "type": "string"
            },
            "series": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "total_loans": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "period_type",
            "period_start",
            "period_end",
            "total_loans",
            "series"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "BearerAuth": {
          "bearerFormat": "JWT",
          "scheme": "bearer",
          "type": "http"
        }
      }
    },
    "info": {
      "title": "図書館管理API",
      "version": "1.0.0"
    },
    "openapi": "3.1.0",
    "paths": {
