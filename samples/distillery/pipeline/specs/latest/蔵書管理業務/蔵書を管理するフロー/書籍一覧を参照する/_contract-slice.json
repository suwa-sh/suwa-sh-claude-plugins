{
  "asyncapi": null,
  "openapi": {
    "components": {
      "schemas": {
        "Book": {
          "additionalProperties": false,
          "properties": {
            "author": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "book_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "current_status": {
              "enum": [
                "在庫あり",
                "貸出中",
                "予約待ち"
              ],
              "type": "string"
            },
            "genre_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "genre_name": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "isbn": {
              "anyOf": [
                {
                  "pattern": "^(?:[0-9]{9}[0-9X]|[0-9]{13})$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "media_type": {
              "enum": [
                "紙",
                "電子"
              ],
              "type": "string"
            },
            "my_reservation": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "current_status": {
                      "enum": [
                        "予約中",
                        "通知済み"
                      ],
                      "type": "string"
                    },
                    "queue_position": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "reservation_id": {
                      "maxLength": 255,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "reservation_id",
                    "queue_position",
                    "current_status"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "publisher": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "registered_at": {
              "format": "date-time",
              "type": "string"
            },
            "reservation_count": {
              "minimum": 0,
              "type": "integer"
            },
            "title": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "updated_at": {
              "format": "date-time",
              "type": "string"
            },
            "version": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "book_id",
            "title",
            "author",
            "isbn",
            "publisher",
            "genre_id",
            "media_type",
            "current_status",
            "version",
            "updated_at",
            "registered_at",
            "genre_name",
            "reservation_count",
            "my_reservation"
          ],
          "type": "object"
        },
        "Error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_INPUT",
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "NOT_FOUND",
                "VERSION_CONFLICT",
                "IDEMPOTENCY_CONFLICT",
                "BUSINESS_RULE_VIOLATION",
                "CONFIGURATION_UNAVAILABLE",
                "DEPENDENCY_UNAVAILABLE"
              ],
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "trace_id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "trace_id"
          ],
          "type": "object"
        },
        "Genre": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "anyOf": [
                {
                  "maxLength": 10000,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "genre_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "genre_name": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "genre_id",
            "genre_name",
            "description"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "BearerAuth": {
          "bearerFormat": "JWT",
          "scheme": "bearer",
          "type": "http"
        }
      }
    },
    "info": {
      "title": "図書館管理API",
      "version": "1.0.0"
    },
    "openapi": "3.1.0",
    "paths": {
      "/genres": {
        "get": {
          "operationId": "listGenres",
          "parameters": [
            {
              "in": "query",
              "name": "page",
              "schema": {
                "default": 1,
                "minimum": 1,
                "type": "integer"
              }
            },
            {
              "in": "query",
              "name": "page_size",
              "schema": {
                "default": 20,
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "additionalProperties": false,
                    "properties": {
                      "items": {
                        "items": {
                          "$ref": "#/components/schemas/Genre"
                        },
                        "type": "array"
                      },
                      "page": {
                        "type": "integer"
                      },
                      "page_size": {
                        "type": "integer"
                      },
                      "total": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "items",
                      "page",
                      "page_size",
                      "total"
                    ],
                    "type": "object"
                  }
                }
              },
              "description": "処理結果"
            },
            "400": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "入力形式不正"
            },
            "401": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "認証が必要"
            },
            "403": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "権限または接続経路違反"
            },
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "対象なし"
            },
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "競合または冪等キー不一致"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "業務条件不成立"
            },
            "503": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "設定または依存先を利用不可"
            }
          },
          "summary": "書籍一覧を参照するの入力・確認データ取得",
          "tags": [
            "蔵書管理業務"
          ],
          "x-allowed-roles": [
            "司書",
            "利用者"
          ],
          "x-authorization-rule": "ロールと経路を検証する。",
          "x-network": "公開"
        }
      },
      "/staff/books": {
        "get": {
          "operationId": "listBooks",
          "parameters": [
            {
              "in": "query",
              "name": "page",
              "schema": {
                "default": 1,
                "minimum": 1,
                "type": "integer"
              }
            },
            {
              "in": "query",
              "name": "page_size",
              "schema": {
                "default": 20,
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            },
            {
              "explode": true,
              "in": "query",
              "name": "genre_ids",
              "schema": {
                "items": {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "style": "form"
            },
            {
              "explode": true,
              "in": "query",
              "name": "states",
              "schema": {
                "items": {
                  "enum": [
                    "在庫あり",
                    "貸出中",
                    "予約待ち"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "style": "form"
            },
            {
              "in": "query",
              "name": "kind",
              "schema": {
                "default": "キーワード",
                "enum": [
                  "キーワード",
                  "タイトル",
                  "著者",
                  "ISBN",
                  "ジャンル"
                ],
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "query",
              "schema": {
                "maxLength": 255,
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "additionalProperties": false,
                    "properties": {
                      "items": {
                        "items": {
                          "$ref": "#/components/schemas/Book"
                        },
                        "type": "array"
                      },
                      "page": {
                        "type": "integer"
                      },
                      "page_size": {
                        "type": "integer"
                      },
                      "total": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "items",
                      "page",
                      "page_size",
                      "total"
                    ],
                    "type": "object"
                  }
                }
              },
              "description": "処理結果"
            },
            "400": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "入力形式不正"
            },
            "401": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "認証が必要"
            },
            "403": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "権限または接続経路違反"
            },
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "対象なし"
            },
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "競合または冪等キー不一致"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "業務条件不成立"
            },
            "503": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "設定または依存先を利用不可"
            }
          },
          "summary": "書籍一覧を参照する",
          "tags": [
            "蔵書管理業務"
          ],
          "x-allowed-roles": [
            "司書"
          ],
          "x-authorization-rule": "ロールと経路を検証する。",
          "x-network": "館内"
        }
      }
    },
    "security": [
      {
        "BearerAuth": []
      }
    ],
    "servers": [
      {
        "url": "https://library.example.invalid/api"
      }
    ]
  },
  "schema_version": "distillery.contract-slice/v1"
}
