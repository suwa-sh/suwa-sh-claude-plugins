{
  "asyncapi": {
    "asyncapi": "3.0.0",
    "channels": {
      "return-notification": {
        "address": "library.return-notification.v1",
        "messages": {
          "ReturnNotificationRequest": {
            "$ref": "#/components/messages/ReturnNotificationRequest"
          }
        }
      }
    },
    "components": {
      "messages": {
        "ReturnNotificationRequest": {
          "contentType": "application/json",
          "correlationId": {
            "location": "$message.header#/message_id"
          },
          "headers": {
            "additionalProperties": false,
            "properties": {
              "message_id": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "message_id"
            ],
            "type": "object"
          },
          "name": "ReturnNotificationRequest",
          "payload": {
            "$ref": "#/components/schemas/ReturnNotificationRequestPayload"
          },
          "title": "返却通知を送信する"
        }
      },
      "schemas": {
        "ReturnNotificationRequestPayload": {
          "additionalProperties": false,
          "properties": {
            "notification_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "reservation_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "trace_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "notification_id",
            "reservation_id",
            "trace_id"
          ],
          "type": "object"
        }
      }
    },
    "info": {
      "title": "図書館通知・日次処理契約",
      "version": "1.0.0"
    },
    "operations": {
      "publishReturnNotification": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/return-notification"
        },
        "messages": [
          {
            "$ref": "#/channels/return-notification/messages/ReturnNotificationRequest"
          }
        ]
      }
    }
  },
  "openapi": {
    "components": {
      "schemas": {
        "Book": {
          "additionalProperties": false,
          "properties": {
            "author": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "book_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "current_status": {
              "enum": [
                "在庫あり",
                "貸出中",
                "予約待ち"
              ],
              "type": "string"
            },
            "genre_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "genre_name": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "isbn": {
              "anyOf": [
                {
                  "pattern": "^(?:[0-9]{9}[0-9X]|[0-9]{13})$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "media_type": {
              "enum": [
                "紙",
                "電子"
              ],
              "type": "string"
            },
            "my_reservation": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "current_status": {
                      "enum": [
                        "予約中",
                        "通知済み"
                      ],
                      "type": "string"
                    },
                    "queue_position": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "reservation_id": {
                      "maxLength": 255,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "reservation_id",
                    "queue_position",
                    "current_status"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "publisher": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "registered_at": {
              "format": "date-time",
              "type": "string"
            },
            "reservation_count": {
              "minimum": 0,
              "type": "integer"
            },
            "title": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "updated_at": {
              "format": "date-time",
              "type": "string"
            },
            "version": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "book_id",
            "title",
            "author",
            "isbn",
            "publisher",
            "genre_id",
            "media_type",
            "current_status",
            "version",
            "updated_at",
            "registered_at",
            "genre_name",
            "reservation_count",
            "my_reservation"
          ],
          "type": "object"
        },
        "Error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_INPUT",
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "NOT_FOUND",
                "VERSION_CONFLICT",
                "IDEMPOTENCY_CONFLICT",
                "BUSINESS_RULE_VIOLATION",
                "CONFIGURATION_UNAVAILABLE",
                "DEPENDENCY_UNAVAILABLE"
              ],
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "trace_id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "trace_id"
          ],
          "type": "object"
        },
        "Reservation": {
          "additionalProperties": false,
          "properties": {
            "accepted_at": {
              "format": "date-time",
              "type": "string"
            },
            "book_author": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "book_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "book_title": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "current_status": {
              "enum": [
                "予約中",
                "通知済み",
                "取消",
                "終了"
              ],
              "type": "string"
            },
            "queue_position": {
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "reservation_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "updated_at": {
              "format": "date-time",
              "type": "string"
            },
            "user_name": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "user_number": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "reservation_id",
            "book_id",
            "user_number",
            "accepted_at",
            "queue_position",
            "current_status",
            "version",
            "updated_at",
            "book_title",
            "book_author",
            "user_name"
          ],
          "type": "object"
        },
        "VersionInput": {
          "additionalProperties": false,
          "properties": {
            "version": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "version"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "BearerAuth": {
          "bearerFormat": "JWT",
          "scheme": "bearer",
          "type": "http"
        }
      }
    },
    "info": {
      "title": "図書館管理API",
      "version": "1.0.0"
    },
    "openapi": "3.1.0",
    "paths": {
      "/books/{book_id}": {
        "get": {
          "operationId": "getBook",
          "parameters": [
            {
              "in": "path",
              "name": "book_id",
              "required": true,
              "schema": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              },
              "description": "処理結果"
            },
            "400": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "入力形式不正"
            },
            "401": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "認証が必要"
            },
            "403": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "権限または接続経路違反"
            },
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "対象なし"
            },
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "競合または冪等キー不一致"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "業務条件不成立"
            },
            "503": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "設定または依存先を利用不可"
            }
          },
          "summary": "書籍詳細を参照する",
          "tags": [
            "蔵書管理業務"
          ],
          "x-allowed-roles": [
            "司書",
            "利用者"
          ],
          "x-authorization-rule": "ロールと経路を検証する。",
          "x-network": "公開"
        }
      },
      "/reservations/{reservation_id}": {
        "get": {
          "operationId": "getReservation",
          "parameters": [
            {
              "in": "path",
              "name": "reservation_id",
              "required": true,
              "schema": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Reservation"
                  }
                }
              },
              "description": "処理結果"
            },
            "400": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "入力形式不正"
            },
            "401": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "認証が必要"
            },
            "403": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "権限または接続経路違反"
            },
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "対象なし"
            },
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "競合または冪等キー不一致"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "業務条件不成立"
            },
            "503": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "設定または依存先を利用不可"
            }
          },
          "summary": "予約を取り消すの入力・確認データ取得",
          "tags": [
            "貸出業務"
          ],
          "x-allowed-roles": [
            "司書",
            "利用者"
          ],
          "x-authorization-rule": "本人の利用者番号でスコープを制限する。",
          "x-network": "公開"
        }
      },
      "/reservations/{reservation_id}/cancel": {
        "post": {
          "operationId": "cancelReservation",
          "parameters": [
            {
              "in": "path",
              "name": "reservation_id",
              "required": true,
              "schema": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              }
            },
            {
              "in": "header",
              "name": "X-Idempotency-Key",
              "required": true,
              "schema": {
                "format": "uuid",
                "type": "string"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInput"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Reservation"
                  }
                }
              },
              "description": "処理結果"
            },
            "400": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "入力形式不正"
            },
            "401": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "認証が必要"
            },
            "403": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "権限または接続経路違反"
            },
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "対象なし"
            },
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "競合または冪等キー不一致"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "業務条件不成立"
            },
            "503": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "設定または依存先を利用不可"
            }
          },
          "summary": "予約を取り消す",
          "tags": [
