{
  "asyncapi": null,
  "openapi": {
    "components": {
      "schemas": {
        "Error": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "enum": [
                "INVALID_INPUT",
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "NOT_FOUND",
                "VERSION_CONFLICT",
                "IDEMPOTENCY_CONFLICT",
                "BUSINESS_RULE_VIOLATION",
                "CONFIGURATION_UNAVAILABLE",
                "DEPENDENCY_UNAVAILABLE"
              ],
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "trace_id": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "trace_id"
          ],
          "type": "object"
        },
        "Loan": {
          "additionalProperties": false,
          "properties": {
            "book_author": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "book_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "book_title": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "current_status": {
              "enum": [
                "貸出中",
                "延滞",
                "返却済み"
              ],
              "type": "string"
            },
            "due_date": {
              "format": "date",
              "type": "string"
            },
            "loan_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "loaned_on": {
              "format": "date",
              "type": "string"
            },
            "recorded_by": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "returned_on": {
              "format": "date",
              "type": [
                "string",
                "null"
              ]
            },
            "updated_at": {
              "format": "date-time",
              "type": "string"
            },
            "user_name": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "user_number": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "loan_id",
            "book_id",
            "user_number",
            "loaned_on",
            "due_date",
            "current_status",
            "recorded_by",
            "version",
            "updated_at",
            "returned_on",
            "book_title",
            "book_author",
            "user_name"
          ],
          "type": "object"
        },
        "Notification": {
          "additionalProperties": false,
          "properties": {
            "body": {
              "maxLength": 10000,
              "type": "string"
            },
            "notification_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "notification_type": {
              "enum": [
                "返却通知",
                "リマインド",
                "督促"
              ],
              "type": "string"
            },
            "recipient_email": {
              "format": "email",
              "maxLength": 254,
              "type": "string"
            },
            "send_result": {
              "enum": [
                "成功",
                "失敗"
              ],
              "type": "string"
            },
            "sent_at": {
              "format": "date-time",
              "type": "string"
            },
            "subject": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "target_loan_id": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "target_reservation_id": {
              "anyOf": [
                {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "user_number": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "notification_id",
            "user_number",
            "notification_type",
            "recipient_email",
            "subject",
            "body",
            "sent_at",
            "send_result",
            "target_loan_id",
            "target_reservation_id"
          ],
          "type": "object"
        },
        "OverdueLoan": {
          "additionalProperties": false,
          "properties": {
            "book_title": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "loan": {
              "$ref": "#/components/schemas/Loan"
            },
            "notifications": {
              "items": {
                "$ref": "#/components/schemas/Notification"
              },
              "type": "array"
            },
            "user_name": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "loan",
            "book_title",
            "user_name",
            "notifications"
          ],
          "type": "object"
        }
      },
      "securitySchemes": {
        "BearerAuth": {
          "bearerFormat": "JWT",
          "scheme": "bearer",
          "type": "http"
        }
      }
    },
    "info": {
      "title": "図書館管理API",
      "version": "1.0.0"
    },
    "openapi": "3.1.0",
    "paths": {
      "/staff/loans/overdue": {
        "get": {
          "operationId": "listOverdueLoans",
          "parameters": [
            {
              "in": "query",
              "name": "page",
              "schema": {
                "default": 1,
                "minimum": 1,
                "type": "integer"
              }
            },
            {
              "in": "query",
              "name": "page_size",
              "schema": {
                "default": 20,
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "additionalProperties": false,
                    "properties": {
                      "items": {
                        "items": {
                          "$ref": "#/components/schemas/OverdueLoan"
                        },
                        "type": "array"
                      },
                      "page": {
                        "type": "integer"
                      },
                      "page_size": {
                        "type": "integer"
                      },
                      "total": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "items",
                      "page",
                      "page_size",
                      "total"
                    ],
                    "type": "object"
                  }
                }
              },
              "description": "処理結果"
            },
            "400": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "入力形式不正"
            },
            "401": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "認証が必要"
            },
            "403": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "権限または接続経路違反"
            },
            "404": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "対象なし"
            },
            "409": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "競合または冪等キー不一致"
            },
            "422": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "業務条件不成立"
            },
            "503": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Error"
                  }
                }
              },
              "description": "設定または依存先を利用不可"
            }
          },
          "summary": "延滞一覧を参照する",
          "tags": [
            "期限管理業務"
          ],
          "x-allowed-roles": [
            "司書"
          ],
          "x-authorization-rule": "ロールと経路を検証する。",
          "x-network": "館内"
        }
      }
    },
    "security": [
      {
        "BearerAuth": []
      }
    ],
    "servers": [
      {
        "url": "https://library.example.invalid/api"
      }
    ]
  },
  "schema_version": "distillery.contract-slice/v1"
}
