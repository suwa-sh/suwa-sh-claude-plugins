{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "ucs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "distillery2.uc-index/v1" },
    "ucs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug"],
        "additionalProperties": false,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "operations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "messages": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "tables": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
