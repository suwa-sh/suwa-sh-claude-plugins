{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Use Cases (distillery2)",
  "description": "docs/requirements/use-cases.yaml のスキーマ。requirements.yaml (USDM) と RDRA の BUC.tsv から genUseCases.js が導出する UC 一覧。",
  "type": "object",
  "required": ["version", "system_name", "use_cases"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "system_name": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string" },
    "use_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/use_case" }
    }
  },
  "$defs": {
    "use_case": {
      "type": "object",
      "required": ["uc_id", "business", "buc", "uc", "slug", "spec_ids", "actors", "status"],
      "properties": {
        "uc_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}([0-9a-f]{4})?$",
          "description": "業務・BUC・UC の canonical JSON 配列 (NFC 正規化) の sha256 先頭 8 桁 (衝突時は全 UC で 12 桁)"
        },
        "business": { "type": "string", "minLength": 1 },
        "buc": { "type": "string", "minLength": 1 },
        "uc": { "type": "string", "minLength": 1 },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "英語 kebab-case。genUseCases.js は暫定 uc-<uc_id> を置き、LLM が意味のある英名へ差し替える"
        },
        "spec_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SPEC-[0-9]{3}-[0-9]{2}$" }
        },
        "spec_ids_added": {
          "type": "array",
          "items": { "type": "string", "pattern": "^SPEC-[0-9]{3}-[0-9]{2}$" },
          "description": "再生成で新たに推定候補へ増えた SPEC。LLM が採否を絞るための差分 (絞り込み後は削除してよい)"
        },
        "actors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tiers_hint": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "type": "string",
          "enum": ["planned", "in_progress", "done"]
        }
      }
    }
  }
}
